{
  "name": "dca-ingestion",
  "version": "1.0.0",
  "description": "Daily Current Affairs: free-source news ingestion and AI drafting (Firebase Cloud Functions)",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest:live": "tsx scripts/dryRun.ts --live",
    "ingest:fixtures": "tsx scripts/dryRun.ts",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22"
  },
  "private": true
}